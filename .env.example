# Application Environment
NODE_ENV=development
PORT=3000

# Database Connection
DATABASE_URL="file:./dev.db"

# NVIDIA AI API (OpenAI Compatible Format)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# AI & Memory API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

BREETH_API_KEY=your_breeth_api_key_here
BREETH_BASE_URL=https://api.thebreeth.com

# Autonomous Agent Timing & Constraints
AGENT_DISCOVERY_INTERVAL_MINUTES=15
AGENT_MIN_PUBLISH_INTERVAL_MINUTES=120
AGENT_MAX_POSTS_PER_DAY=6
